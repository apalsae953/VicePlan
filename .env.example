# Copia este archivo a `.env.local` y pega la configuración de tu app web de
# Firebase (Consola → Configuración del proyecto → General → Tus apps → SDK).
# Son valores públicos por diseño: la seguridad la ponen las reglas de
# Firestore (firestore.rules), no el secreto de estas claves.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Desarrollo local sin credenciales (Firebase Emulator Suite):
#   terminal 1 → npm run emulators
#   terminal 2 → npm run dev:emulators
# Ese script fija todas las NEXT_PUBLIC_FIREBASE_* por entorno, sin tocar este archivo:
# NEXT_PUBLIC_FIREBASE_USE_EMULATORS=true
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-controltrabajo

# Avisos por email (servidor, NO públicas): cuenta de Gmail y su contraseña de aplicación.
# En Vercel: Settings → Environment Variables. Sin ellas no se envía ningún email.
SMTP_USER=
SMTP_PASS=
